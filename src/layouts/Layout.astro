---
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-500.css';
import '@fontsource/geist/latin-600.css';
import '@fontsource/geist-mono/latin-400.css';
import '@once-ui-system/core/css/tokens.css';
import '@once-ui-system/core/css/styles.css';
import headingFont from '@fontsource/geist/files/geist-latin-600-normal.woff2?url';
import '../styles/global.css';
import Portfolio from '../components/Portfolio';
import { copy, locales, route, type Locale, type Page } from '../data/locales';
import type { Project } from '../data/projects';
import type { DemoScene } from '../spoor/demo/fixtures';

interface Props {
  locale: Locale;
  page: Page;
  projectSlug?: string;
  project?: Project;
  title?: string;
  description?: string;
  previewScene?: DemoScene;
}
const {
  locale,
  page,
  projectSlug,
  project,
  previewScene,
  title = copy[locale].title,
  description = copy[locale].description,
} = Astro.props;
const canonical = new URL(route(locale, page, projectSlug), Astro.site);
const ogLocales = { fr: 'fr_FR', en: 'en_US', es: 'es_ES' };
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Voldigoade',
  url: Astro.site?.href,
  inLanguage: locales,
  sameAs: ['https://github.com/Voldigoade'],
};
const languageNavigation = `document.addEventListener('click', (event) => {
  const link = event.target instanceof Element ? event.target.closest('.languages a') : null;
  if (link instanceof HTMLAnchorElement) link.hash = window.location.hash;
}, true);`;
const languageHash = await crypto.subtle.digest(
  'SHA-256',
  new TextEncoder().encode(languageNavigation),
);
Astro.csp?.insertScriptHash(
  `sha256-${btoa(String.fromCharCode(...new Uint8Array(languageHash)))}`,
);
---

<!doctype html>
<html
  lang={locale}
  data-theme="dark"
  data-neutral="gray"
  data-brand="blue"
  data-accent="indigo"
  data-solid="contrast"
  data-solid-style="flat"
  data-border="rounded"
  data-surface="filled"
  data-transition="micro"
  data-scaling="100"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>Voldigoade</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {page === '404' ? (
      <meta name="robots" content="noindex,follow" />
    ) : (
      <>
        {locales.map((lang) => (
          <link
            rel="alternate"
            hreflang={lang}
            href={new URL(route(lang, page, projectSlug), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(route('fr', page, projectSlug), Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Voldigoade" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales
      .filter((lang) => lang !== locale)
      .map((lang) => (
        <meta property="og:locale:alternate" content={ogLocales[lang]} />
      ))}
    <meta
      property="og:image"
      content={new URL(`/og-${locale}.png`, Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy[locale].title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(`/og-${locale}.png`, Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={headingFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body id="top" data-page={page}>
    <script is:inline set:html={languageNavigation} />
    <Portfolio
      locale={locale}
      page={page}
      project={project}
      previewScene={previewScene}
      client:load
    />
    {import.meta.env.DEV && previewScene && (
      <aside class="preview-notice">Aperçu local · données fictives</aside>
    )}
  </body>
</html>
