---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import headingFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-500-normal.woff2?url';
import '../styles/global.css';
import {
  copy,
  languageNames,
  locales,
  route,
  type Locale,
  type Page,
} from '../data/locales';
import Arrow from '../components/Arrow.astro';
import { experience } from '../data/experience';

interface Props {
  locale: Locale;
  page: Page;
  projectSlug?: string;
  title?: string;
  description?: string;
}
const {
  locale,
  page,
  projectSlug,
  title = copy[locale].title,
  description = copy[locale].description,
} = Astro.props;
const t = copy[locale];
const e = experience[locale];
const canonical = new URL(route(locale, page, projectSlug), Astro.site);
const ogLocales = { fr: 'fr_FR', en: 'en_US', es: 'es_ES' };
const sections = ['work', 'areas', 'approach'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Voldigoade',
  url: Astro.site?.href,
  inLanguage: locales,
  sameAs: ['https://github.com/Voldigoade'],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c1013" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {page === '404' ? (
      <meta name="robots" content="noindex,follow" />
    ) : (
      <>
        {locales.map((lang) => (
          <link
            rel="alternate"
            hreflang={lang}
            href={new URL(route(lang, page, projectSlug), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(route('fr', page, projectSlug), Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Voldigoade" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales
      .filter((lang) => lang !== locale)
      .map((lang) => (
        <meta property="og:locale:alternate" content={ogLocales[lang]} />
      ))}
    <meta
      property="og:image"
      content={new URL(`/og-${locale}.png`, Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(`/og-${locale}.png`, Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <noscript>
      <link rel="stylesheet" href="/static.css" />
    </noscript>
    <link
      rel="preload"
      href={headingFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body id="top" data-page={page}>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="site-header">
      <a
        class="wordmark"
        href={route(locale)}
        aria-label="Voldigoade"
        translate="no"
      >
        <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
          <path d="M5 6h4l7 20h-4zM23 6h4l-11 26h-4z" fill="currentColor" />
          <circle cx="29" cy="28" r="3" class="mark-dot" />
        </svg>
      </a>
      <nav class="main-nav" aria-label={t.navLabel}>
        {t.nav.map((label, i) => (
          <a
            href={`${route(locale)}#${sections[i]}`}
            data-section-link
            aria-current={
              page === 'project' && i === 0 ? 'location' : undefined
            }
          >
            {label}
          </a>
        ))}
      </nav>
      <button
        class="motion-toggle"
        type="button"
        data-motion-toggle
        data-pause={e.pause}
        data-resume={e.resume}
        aria-label={e.pause}
        aria-pressed="false"
        hidden
      >
        <svg
          class="pause-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="M8 5v14M16 5v14" />
        </svg>
        <svg
          class="play-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="m8 5 11 7-11 7Z" />
        </svg>
      </button>
      <nav class="languages" aria-label={t.languageLabel}>
        {locales.map((lang) => (
          <a
            href={route(lang, page, projectSlug)}
            hreflang={lang}
            lang={lang}
            aria-label={languageNames[lang]}
            aria-current={lang === locale ? 'page' : undefined}
            data-locale-link
          >
            {lang.toUpperCase()}
          </a>
        ))}
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div>
        <a class="footer-name" href={route(locale)} translate="no">
          Voldigoade
        </a>
        <p>{t.footer}</p>
      </div>
      <div class="footer-links">
        <a href={route(locale, 'privacy')}>{t.privacy}</a>
        <a href="#top">
          {t.top}
          <Arrow direction="up" />
        </a>
      </div>
    </footer>
    <script>
      import { initNavigation } from '../scripts/interactions';
      initNavigation();
    </script>
  </body>
</html>
