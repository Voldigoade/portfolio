---
import { copy, route, type Locale } from '../data/locales';
import Arrow from './Arrow.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<article class="wrap prose-page">
  <a class="back-link text-link" href={route(locale)}>
    <Arrow direction="back" />
    {t.home}
  </a>
  <h1>{t.privacyTitle}</h1>
  <p class="lead">{t.privacyDescription}</p>
  {t.privacySections.map((section) => (
    <section>
      <h2>{section.title}</h2>
      <p>{section.text}</p>
    </section>
  ))}
  <a class="underlined-link" href="https://vercel.com/legal/privacy-policy">
    {t.hostPrivacy}
    <Arrow />
  </a>
</article>
