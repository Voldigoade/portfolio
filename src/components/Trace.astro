---
interface Props {
  labels: readonly string[];
}
const { labels } = Astro.props;
---

<div class="layer-traces" aria-hidden="true">
  {labels.map((label) => (
    <div class="layer-trace">
      <span>{label}</span>
      <svg viewBox="0 0 320 48" preserveAspectRatio="none">
        <path d="M0 8 H112 L142 38 H320" />
      </svg>
    </div>
  ))}
</div>
