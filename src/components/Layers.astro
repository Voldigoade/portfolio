---
import { experience, layerIds } from '../data/experience';
import type { Locale } from '../data/locales';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = experience[locale];
---

<section
  class="layers-section wrap"
  id="areas"
  aria-labelledby="layers-heading"
  data-layer-explorer
  data-active="1"
  data-motion-region
>
  <div class="center-heading">
    <h2 id="layers-heading">{t.layerTitle}</h2>
    <p>{t.layerIntro}</p>
  </div>
  <div class="layer-system">
    <svg
      class="mobile-layer-rail"
      viewBox="0 0 300 210"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M50 45H250V165H50" />
      <path class="rail-pulse" d="M50 45H250V165H50" />
    </svg>
    <svg
      class="layer-rail"
      viewBox="0 0 1100 180"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M110 45H210Q220 45 220 55V85Q220 95 230 95H430Q440 95 440 85V55Q440 45 450 45H650Q660 45 660 55V105Q660 115 670 115H870Q880 115 880 105V55Q880 45 890 45H990" />
      <path
        class="rail-pulse"
        d="M110 45H210Q220 45 220 55V85Q220 95 230 95H430Q440 95 440 85V55Q440 45 450 45H650Q660 45 660 55V105Q660 115 670 115H870Q880 115 880 105V55Q880 45 890 45H990"
      />
    </svg>
    <div class="layer-tabs" aria-label={t.layerLabel} data-layer-tabs>
      {t.layers.map((layer, i) => (
        <a
          href={`#layer-${layerIds[i]}`}
          id={`layer-tab-${layerIds[i]}`}
          class:list={['layer-node', { 'is-active': i === 1 }]}
          data-layer-index={i}
        >
          <span class="coordinate" aria-hidden="true">
            <span></span>
          </span>
          <span>{layer.label}</span>
        </a>
      ))}
    </div>
  </div>
  <div class="layer-context">
    <div class="layer-panels" aria-live="polite">
      {t.layers.map((layer, i) => (
        <section
          id={`layer-${layerIds[i]}`}
          class="layer-panel"
          data-layer-panel={i}
        >
          <h3>{layer.title}</h3>
          <p>{layer.text}</p>
          <p class="layer-detail">{layer.detail}</p>
        </section>
      ))}
    </div>
    <svg class="layer-stack" viewBox="0 0 360 260" aria-hidden="true">
      {[0, 1, 2, 3, 4].map((i) => (
        <g class:list={{ 'is-active': i === 1 }} data-stack-layer={i}>
          <path
            d={`M35 ${100 + i * 24}L180 ${56 + i * 24}L325 ${100 + i * 24}L180 ${144 + i * 24}Z`}
          />
          <path class="stack-corner" d={`M180 ${144 + i * 24}v12`} />
        </g>
      ))}
      <path class="stack-axis" d="M180 35V250M15 230H345" />
    </svg>
  </div>
</section>
<script>
  import { initLayerExplorers } from '../scripts/interactions';
  initLayerExplorers();
</script>
