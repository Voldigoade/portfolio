---
interface Props {
  direction?: 'right' | 'up' | 'back';
}
const { direction = 'right' } = Astro.props;
---

<svg
  class:list={['arrow', direction]}
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  <path d="M4 12h15m-6-6 6 6-6 6" />
</svg>
