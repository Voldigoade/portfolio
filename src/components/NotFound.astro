---
import { copy, route, type Locale } from '../data/locales';
import Arrow from './Arrow.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<div class="wrap prose-page not-found">
  <p class="status">404</p>
  <h1>{t.notFound}</h1>
  <p class="lead">{t.notFoundText}</p>
  <a class="button" href={route(locale)}>
    {t.home}
    <Arrow />
  </a>
</div>
