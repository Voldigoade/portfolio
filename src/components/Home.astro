---
import { copy, route, type Locale } from '../data/locales';
import { experience } from '../data/experience';
import { projects } from '../data/projects';
import Arrow from './Arrow.astro';
import SignalField from './SignalField.astro';
import ResearchPreview from './ResearchPreview.astro';
import Layers from './Layers.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const e = experience[locale];
---

<section class="identity-hero" aria-labelledby="hero-heading">
  <SignalField />
  <div class="identity-content wrap">
    <h1 id="hero-heading" translate="no">
      Voldigoade
    </h1>
    <p class="identity-line">{e.identity}</p>
    <p class="identity-fields">
      {e.fields.map((field, i) => (
        <span>
          {field}
          {i < e.fields.length - 1 && (
            <span class="field-divider" aria-hidden="true">
              /
            </span>
          )}
        </span>
      ))}
    </p>
    <div class="actions hero-actions">
      <a class="button" href="#work">
        {e.explore}
        <Arrow />
      </a>
      <a class="button button-secondary" href="https://github.com/Voldigoade">
        GitHub
        <Arrow />
      </a>
    </div>
  </div>
  <a class="scroll-cue" href="#work" aria-label={e.explore}>
    <Arrow direction="down" />
  </a>
</section>
<section class="work-section wrap" id="work" aria-labelledby="work-heading">
  <div class="section-heading">
    <h2 id="work-heading">{t.work}</h2>
    <span class="section-thread" aria-hidden="true"></span>
  </div>
  {projects.map((project) => {
    const p = project.translations[locale];
    const href = route(locale, 'project', project.slug);
    return (
      <article class="project-feature">
        <ResearchPreview locale={locale} slug={project.slug} href={href} />
        <div class="project-caption">
          <div>
            <p class="status">{p.status}</p>
            <h3>
              <a href={href}>{p.title}</a>
            </h3>
            <p>{e.projectLine}</p>
          </div>
          <div class="actions">
            <a class="button" href={href}>
              {t.read}
              <Arrow />
            </a>
            <a class="button button-secondary" href={project.repository}>
              {t.repository}
              <Arrow />
            </a>
          </div>
        </div>
      </article>
    );
  })}
</section>
<div class="section-connector" aria-hidden="true">
  <svg viewBox="0 0 500 130">
    <path d="M120 0V30Q120 50 140 50H340Q360 50 360 70V130" />
  </svg>
</div>
<Layers locale={locale} />
<section
  class="profile-section wrap"
  id="approach"
  aria-labelledby="approach-heading"
  data-motion-region
>
  <div class="profile-copy">
    <h2 id="approach-heading">
      {e.approach.map((word) => (
        <span>{word}</span>
      ))}
    </h2>
    <p>{e.profile}</p>
  </div>
  <a class="github-contact" href="https://github.com/Voldigoade">
    <span>{e.contact}</span>
    <Arrow />
  </a>
</section>
