---
import { copy, route, type Locale } from '../data/locales';
import { projects } from '../data/projects';
import Arrow from './Arrow.astro';
import Trace from './Trace.astro';
import SectionTitle from './SectionTitle.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<div class="wrap">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <h1 id="hero-heading">
        {t.hero[0]}
        <br />
        {t.hero[1]} <em>{t.hero[2]}</em>
      </h1>
      <p class="hero-intro">{t.intro}</p>
      <div class="actions">
        <a class="button" href="#work">
          {t.explore}
          <Arrow />
        </a>
        <a class="text-link" href="https://github.com/Voldigoade">
          GitHub
          <Arrow />
        </a>
      </div>
    </div>
    <Trace labels={t.trace} />
  </section>
  <section class="work-section traced-section" id="work" aria-label={t.work}>
    <SectionTitle title={t.work} aside={t.workAside} />
    {projects.map((project) => {
      const p = project.translations[locale];
      return (
        <article class="project-feature">
          <div class="project-copy">
            <p class="status">{p.status}</p>
            <h3>
              <a href={route(locale, 'project')}>{p.title}</a>
            </h3>
            <p class="project-summary">{p.summary}</p>
            <p class="project-description">{p.description}</p>
            <div class="actions">
              <a class="underlined-link" href={route(locale, 'project')}>
                {t.read}
                <Arrow />
              </a>
              <a class="text-link" href={project.repository}>
                {t.repository}
                <Arrow />
              </a>
            </div>
          </div>
          <aside class="project-scope">
            <h4>{t.scope}</h4>
            <ul>
              {p.focus.map((focus) => (
                <li>{focus}</li>
              ))}
            </ul>
            <span class="scope-trace" aria-hidden="true"></span>
          </aside>
        </article>
      );
    })}
  </section>
  <section
    class="areas-section traced-section"
    id="areas"
    aria-label={t.layers}
  >
    <SectionTitle title={t.layers} aside={t.layersIntro} />
    <div class="domains">
      {t.domains.map((domain) => (
        <article class="domain">
          <h3>{domain.title}</h3>
          <div>
            <p>{domain.text}</p>
            <p class="domain-detail">{domain.detail}</p>
          </div>
          <span class="row-trace" aria-hidden="true"></span>
        </article>
      ))}
    </div>
  </section>
  <section
    class="approach-section traced-section"
    id="approach"
    aria-labelledby="approach-heading"
  >
    <h2 id="approach-heading">{t.approach}</h2>
    <div class="approach-copy">
      {t.approachText.map((text) => (
        <p>{text}</p>
      ))}
    </div>
  </section>
  <section class="contact-section" aria-labelledby="contact-heading">
    <div>
      <h2 id="contact-heading">{t.contact}</h2>
      <p>{t.contactText}</p>
    </div>
    <a class="underlined-link" href="https://github.com/Voldigoade">
      {t.contactLink}
      <Arrow />
    </a>
  </section>
</div>
