---
import { copy, route, type Locale } from '../data/locales';
import type { Project } from '../data/projects';
import Arrow from './Arrow.astro';
interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const t = copy[locale];
const p = project.translations[locale];
---

<article class="wrap project-page">
  <a class="back-link text-link" href={`${route(locale)}#work`}>
    <Arrow direction="back" />
    {t.back}
  </a>
  <header class="project-header">
    <p class="status">{p.status}</p>
    <h1>{p.title}</h1>
    <p class="lead">{p.description}</p>
    <div class="actions">
      <a class="button" href={project.website[locale]}>
        {t.visit}
        <Arrow />
      </a>
      <a class="text-link" href={project.repository}>
        {t.repository}
        <Arrow />
      </a>
    </div>
  </header>
  <section class="project-context traced-section">
    <h2>{p.question}</h2>
    <p class="lead">{p.context}</p>
  </section>
  <dl class="dimension-list">
    {p.dimensions.map((dimension) => (
      <div>
        <dt>{dimension.title}</dt>
        <dd>{dimension.text}</dd>
        <span class="row-trace" aria-hidden="true"></span>
      </div>
    ))}
  </dl>
  <div class="research-columns">
    <div>
      <section>
        <h2>{p.methodTitle}</h2>
        <p>{p.method}</p>
      </section>
      <section>
        <h2>{p.limitsTitle}</h2>
        <p>{p.limits}</p>
      </section>
    </div>
    <aside class="artifacts">
      <h2>{p.artifactsTitle}</h2>
      <ul>
        {p.artifacts.map((artifact) => (
          <li>{artifact}</li>
        ))}
      </ul>
      <a class="text-link" href={project.repository}>
        {t.repository}
        <Arrow />
      </a>
    </aside>
  </div>
  <section class="research-status traced-section">
    <h2>{p.statusTitle}</h2>
    <p>{p.statusText}</p>
    <a class="underlined-link" href={project.website[locale]}>
      {t.visit}
      <Arrow />
    </a>
  </section>
</article>
