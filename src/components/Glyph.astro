  'M4 4h16v16H4zM8 8h8M8 12h5M8 16h8',
  'M3 7h6v6H3zM15 3h6v6h-6zM15 15h6v6h-6zM9 10h3V6h3M12 10v8h3',
  'M4 5h6v6H4zM14 13h6v6h-6zM10 8h7v5M7 11v5h7',
];
---

<svg
  class="dimension-glyph"
  width="24"
